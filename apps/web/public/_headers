# Cloudflare Pages reads this file from the build output.
#
# Everything under /_next/static/ has a content hash in its name, so a given URL
# never changes what it serves. Pages' default is `max-age=0, must-revalidate`,
# which makes every visit ask again for files that cannot have changed.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
