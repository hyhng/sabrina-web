# Build settings for the public site (apps/web).
#
# Why this is a file in the repo and not variables in the Cloudflare dashboard:
# on 1 October, "Variables and secrets" set on the Pages project never reached
# the build — it listed every variable it could see and none of the four were
# among them. They are runtime variables, and a static site has no runtime. A
# file in the repo is read by `next build` wherever it runs, can be reviewed,
# and cannot drift from what is deployed.
#
# PUBLIC VALUES ONLY. Everything here ends up in the HTML anyway. Secrets belong
# in the git-ignored .env of apps/cms or on the server (CLAUDE.md rule 11).
# apps/web/lib/env-production.test.ts rejects anything that is not on its list.
#
# A variable set in the shell wins over this file, so a one-off build against the
# CMS is still:  CONTENT_SOURCE=payload PAYLOAD_PUBLIC_URL=... pnpm build:web

# Absolute address of the site — sitemap, robots.txt, canonical, social previews.
NEXT_PUBLIC_SITE_URL=https://sabrinakulhankova.photography

# Where photos are served from. /seed is the fixture committed in public/seed;
# it becomes https://img.sabrinakulhankova.photography once photos live in R2.
NEXT_PUBLIC_IMG_BASE=/seed

# seed: the fixture in content/seed.json. payload: the CMS (also needs
# PAYLOAD_PUBLIC_URL). Switched when the admin is on the server.
CONTENT_SOURCE=seed
