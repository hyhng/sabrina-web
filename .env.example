# Copy to .env and fill in. Never commit the filled-in file — .gitignore keeps
# .env* out and lets only this example through (CLAUDE.md, rule 11).
#
# Variables and their meaning: docs/TECH.md section 8.
# The domain is still open question 1 in docs/PHASES.md; example.com stands in
# for it everywhere below.


# ---------------------------------------------------------------- apps/web --

# seed    read content/seed.json — phases F1 and F2, no CMS needed
# payload read the Payload API — wired up in F4
CONTENT_SOURCE=seed

# Where the photos are served from.
# On seed content the photos live in public/seed, so this is a local path:
NEXT_PUBLIC_IMG_BASE=/seed
# On real content it is the R2 custom domain:
# NEXT_PUBLIC_IMG_BASE=https://img.example.com

NEXT_PUBLIC_SITE_URL=https://example.com

# Only read when CONTENT_SOURCE=payload.
PAYLOAD_PUBLIC_URL=https://admin.example.com


# ---------------------------------------------------------------- apps/cms --
# Phase F3. Nothing here is needed to build the public site.

DATABASE_URI=postgres://payload:payload@localhost:5432/payload

# Long random string. Rotating it logs everyone out.
PAYLOAD_SECRET=

# Cloudflare R2. The bucket and token belong to the client's account.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
IMG_BASE_URL=https://img.example.com

# Cloudflare Pages deploy hook behind the "Publikovat web" button.
CF_DEPLOY_HOOK_URL=

# Resend, for admin password resets.
RESEND_API_KEY=
EMAIL_FROM=

# Origin allowed to PUT into R2 — must match the R2 CORS rule.
ADMIN_ORIGIN=https://admin.example.com


# ------------------------------------------------------------- infra/.env --
# These are read by infra/docker-compose.prod.yml and infra/backup.sh on the
# server, not by the apps. Copy this file to infra/.env there.
# Compose refuses to start without the first five and names the missing one.

# admin.<doména>. Caddy gets its certificate for this name; `localhost` runs
# the whole stack on a laptop with Caddy's own local certificate.
ADMIN_DOMAIN=admin.example.com

# Invent these; nothing outside the stack uses them.
POSTGRES_USER=payload
POSTGRES_PASSWORD=
POSTGRES_DB=payload

# Which image the server runs. Defaults to :latest; pin to :sha-<commit> to
# roll back.
# CMS_IMAGE=ghcr.io/hyhng/sabrina-cms:latest

# infra/backup.sh
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/var/backups/sabrina
